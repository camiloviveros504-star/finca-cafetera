{
  "name": "finca-cafetera",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:local": "tsx db/local.ts",
    "db:migrar": "tsx db/migrar.ts",
    "db:reset": "tsx db/reiniciar.ts",
    "tipos": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unitarias",
    "test:integracion": "vitest run tests/integracion tests/concurrencia",
    "capas": "depcruise src --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "db:iniciar": "tsx db/iniciar.ts",
    "e2e": "playwright test",
    "test:todo": "vitest run && npm run capas",
    "capas:probar": "node scripts/probar-capas.mjs",
    "test:volumen": "PRUEBAS_VOLUMEN=si vitest run tests/rendimiento",
    "carga:preparar": "tsx scripts/preparar-carga.ts",
    "iniciar": "tsx db/arrancar.ts",
    "iniciar:ejemplo": "tsx db/arrancar.ts --ejemplo"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "^18.7.2",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
